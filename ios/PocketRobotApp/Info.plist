<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>Pocket Robot</string>
<key>NSBluetoothAlwaysUsageDescription</key><string>Подключение к настольному роботу для передачи уведомлений.</string>
<key>UIBackgroundModes</key><array><string>bluetooth-central</string><string>fetch</string></array>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.pocketrobot.phone.refresh</string></array>
